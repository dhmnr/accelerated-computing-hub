# syntax=docker/dockerfile:1
#
# Image for the stdpar C++ and Fortran tutorials. It needs the NVIDIA HPC SDK
# compilers (nvc++, nvfortran), so it starts from the HPC SDK image instead of
# the shared brev/dockerfile. Build it from the repository root through
# docker-compose.yml.

ARG BASE_IMAGE=nvcr.io/nvidia/nvhpc:26.5-devel-cuda13.2-ubuntu24.04

FROM ${BASE_IMAGE}

# NVIDIA's std::execution implementation, pinned to a commit known to work with
# the tutorial's `stdexec::on(sch, sender)` usage. Bump it with the HPC SDK.
ARG STDEXEC_COMMIT=433dc54f93ab503b5595c2c7c047c8e9b80b62bd

ENV ACH_TUTORIAL=stdpar \
    NVHPC_ROOT=/opt/nvidia/hpc_sdk/Linux_${NVHPC_ARCH}/${HPCSDK_VERSION}

ENV ACH_STDPAR_NVHPC_VERSION=${HPCSDK_VERSION} \
    ACH_STDPAR_ARCH=${NVHPC_ARCH} \
    ACH_NSYS_PATH=${NVHPC_ROOT}/compilers/bin/nsys \
    ACH_NCU_PATH=${NVHPC_ROOT}/compilers/bin/ncu \
    VIRTUAL_ENV=/opt/venv \
    PIP_ROOT_USER_ACTION=ignore \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MPLCONFIGDIR=/tmp/matplotlib \
    PATH=/accelerated-computing-hub/brev/wrappers:/opt/venv/bin:${PATH} \
    # Simplify running HPC-X on systems without InfiniBand.
    OMPI_MCA_coll_hcoll_enable=0 \
    # The exercises do not need UCX VFS, and it is awkward to use from a container.
    UCX_VFS_ENABLE=n \
    # Suppress warnings about UCX cuda_copy failures.
    UCX_LOG_LEVEL=warn \
    # Let HPC-X run more ranks than cores without mpirun --oversubscribe.
    OMPI_MCA_rmaps_base_oversubscribe=true \
    OMPI_ALLOW_RUN_AS_ROOT=1 \
    OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1 \
    OMPI_MCA_hwloc_base_binding_policy=none \
    # Work around the nvfortran limit of 64k thread blocks.
    NVCOMPILER_ACC_GANGLIMIT=67108864

# GCC 13 (Ubuntu 24.04's default) and Clang for the comparison exercises, TBB for
# their parallel algorithms, and the packages the container entrypoints use.
RUN apt-get update -y \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    clang \
    cmake \
    curl \
    git \
    git-lfs \
    gosu \
    libnuma1 \
    libtbb-dev \
    numactl \
    openssh-client \
    python3-dev \
    python3-venv \
    socat \
    sudo \
 && apt-get clean -y \
 && rm -rf /var/lib/apt/lists/* \
 && test -x "${ACH_NSYS_PATH}" \
 && test -x "${ACH_NCU_PATH}"

# Enable passwordless sudo for all users and pass through environment and path.
RUN echo 'ALL ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers \
 && sed -i -e 's/^Defaults\s*env_reset/Defaults !env_reset/' -e 's/^Defaults\s*secure_path=/#&/' /etc/sudoers

# Use the tutorial's cartesian_product view, which copies the underlying range
# iterators instead of reading them through host memory, so it works without
# HMM/ATS.
COPY tutorials/stdpar/include/ach/cartesian_product.hpp /usr/include/ach/cartesian_product.hpp
COPY tutorials/stdpar/include/ranges /usr/include/c++/13/ranges

RUN git init /tmp/stdexec \
 && git -C /tmp/stdexec fetch --depth=1 https://github.com/nvidia/stdexec.git "${STDEXEC_COMMIT}" \
 && git -C /tmp/stdexec checkout FETCH_HEAD \
 && cp -r /tmp/stdexec/include/* /usr/include/ \
 && rm -rf /tmp/stdexec \
 # nvc++ bundles its own stdexec in namespace std::execution; the exercises use
 # ::stdexec with every compiler, so turn the bundled copy off.
 && echo 'set STDEXEC_ENABLED=0;' >> "${NVHPC_ROOT}/compilers/bin/siterc"

# GCC 13 and Clang 18 have no <mdspan>, so give them the HPC SDK's std::mdspan.
RUN test -f "${NVHPC_ROOT}/compilers/include/mdspan" \
 && ln -sf "${NVHPC_ROOT}/compilers/include/mdspan" /usr/include/mdspan \
 && ln -sf "${NVHPC_ROOT}/compilers/include/__linalg" /usr/include/__linalg

# Python is the OS's (3.12 on Ubuntu 24.04), in a virtual environment that
# stays writable so notebooks can pip install.
RUN python3 -m venv "${VIRTUAL_ENV}" \
 && pip install --no-cache-dir --upgrade pip

RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=bind,source=tutorials/stdpar/brev/requirements.txt,target=/tmp/requirements.txt \
    pip install -r /tmp/requirements.txt \
 && chmod -R a+rwX "${VIRTUAL_ENV}" \
 && jupyter labextension disable "@jupyterlab/apputils-extension:announcements" \
 && jupyter labextension disable "@jupyterlab/console-extension:tracker"

COPY --chmod=0777 . /accelerated-computing-hub

WORKDIR /accelerated-computing-hub/tutorials/stdpar/notebooks

ENTRYPOINT ["/accelerated-computing-hub/brev/entrypoint.bash", "jupyter"]
