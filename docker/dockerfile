# syntax=docker/dockerfile:1
#
# Shared image for the Python-based tutorials. Build it from the repository root
# through the tutorial's docker-compose.yml, or directly:
#
#   docker build -f docker/dockerfile --build-arg ACH_TUTORIAL=<tutorial> .
#
# Tutorial-specific inputs live in tutorials/<tutorial>/docker/:
#   requirements.txt  Python packages, installed into /opt/venv with pip (required).
#                     Paths in `-r` lines resolve relative to docker/.
#   install.bash      Extra build steps, run as root after the Python packages
#                     are installed (optional).

ARG BASE_IMAGE=nvcr.io/nvidia/cuda:13.2.1-devel-ubuntu24.04

FROM ${BASE_IMAGE}

ARG ACH_TUTORIAL
# nsightful's profiling kernels need Nsight Systems 2026.1.1 or newer.
ARG NSIGHT_SYSTEMS_VERSION=2026.1.3

ENV ACH_TUTORIAL=${ACH_TUTORIAL} \
    ACH_NSYS_PATH=/usr/local/bin/nsys \
    ACH_NCU_PATH=/usr/local/cuda/bin/ncu \
    VIRTUAL_ENV=/opt/venv \
    PIP_ROOT_USER_ACTION=ignore \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MPLCONFIGDIR=/tmp/matplotlib_cache \
    PATH=/accelerated-computing-hub/docker/wrappers:/opt/venv/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:${PATH}

# System packages used by the container entrypoints and the tutorials, plus
# Nsight Systems from NVIDIA's CUDA apt repository. Nsight Compute already ships
# with the CUDA devel image.
RUN apt-get update -y \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    ffmpeg \
    git \
    git-lfs \
    gosu \
    libegl1 \
    libgl1 \
    libglib2.0-0 \
    python3-dev \
    python3-venv \
    socat \
    sudo \
    "nsight-systems-${NSIGHT_SYSTEMS_VERSION}" \
 && apt-get clean -y \
 && rm -rf /var/lib/apt/lists/* \
 && test -x "${ACH_NSYS_PATH}" \
 && test -x "${ACH_NCU_PATH}"

# Enable passwordless sudo for all users and pass through environment and path.
RUN echo 'ALL ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers \
 && sed -i -e 's/^Defaults\s*env_reset/Defaults !env_reset/' -e 's/^Defaults\s*secure_path=/#&/' /etc/sudoers

# Python is the OS's (3.12 on Ubuntu 24.04), in a virtual environment that
# stays writable so notebooks can pip install.
RUN python3 -m venv "${VIRTUAL_ENV}" \
 && pip install --no-cache-dir --upgrade pip

RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=bind,source=tutorials/${ACH_TUTORIAL},target=/tmp/ach-tutorial \
    cd /tmp/ach-tutorial/docker \
 && pip install -r requirements.txt \
 && if [ -f install.bash ]; then bash -euo pipefail install.bash; fi \
 && chmod -R a+rwX "${VIRTUAL_ENV}"

# Disable unnecessary default Jupyter extensions.
RUN jupyter labextension disable "@jupyterlab/apputils-extension:announcements" \
 && jupyter labextension disable "@jupyterlab/console-extension:tracker"

COPY --chmod=0777 . /accelerated-computing-hub

WORKDIR /accelerated-computing-hub/tutorials/${ACH_TUTORIAL}/notebooks

ENTRYPOINT ["/accelerated-computing-hub/docker/entrypoint.bash", "jupyter"]
